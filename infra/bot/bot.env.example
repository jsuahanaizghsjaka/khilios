# Копия: cp bot.env.example bot.env
# bot.env в git не попадает (.gitignore). Внутри самые опасные строки проекта.

# Токен от @BotFather.
# С ним чужой человек пишет от вашего имени всем вашим клиентам.
# Утёк — немедленно /revoke у @BotFather, а не «потом разберусь».
BOT_TOKEN=""

# Ваш Telegram ID (узнать у @userinfobot). Кто получает админские команды
# /stats и /health, и кому приходит пинг, если оплата прошла, а ключ не выдался.
ADMIN_TELEGRAM_ID=""

# Панель. Локальный адрес: бот стоит на той же машине, поэтому API панели
# наружу открывать не нужно вообще.
PANEL_API_URL="http://127.0.0.1:3000"

# Токен API панели, создаётся в самой панели. Права — минимально необходимые.
PANEL_API_TOKEN=""

# Канал для гейта по подписке, с @. Бот обязан быть его администратором,
# иначе Telegram не даст проверить подписку — и тогда, по правилу «сломанная
# проверка пускает», триал начнут получать все подряд.
# Канал должен быть ОТКРЫТЫМ: вступление по заявке ломает проверку.
CHANNEL_USERNAME="@khilios_vpn"

# Отсечка по возрасту аккаунта: ID выше этого порога триал не получают.
# Пусто = проверка ВЫКЛЮЧЕНА, триал можно выносить новыми аккаунтами.
#
# Как откалибровать (две минуты, делается один раз):
#   1. Зарегистрируйте свежий аккаунт Telegram или попросите знакомого,
#      который завёл его на днях.
#   2. Узнайте его ID у @userinfobot.
#   3. Поставьте сюда значение НЕМНОГО НИЖЕ полученного.
#
# Угадывать нельзя: слишком низкий порог отсекает вообще всех пришедших,
# и заметите вы это по нулю триалов за день, а не по ошибке в логе.
TRIAL_MAX_TELEGRAM_ID=""

# --------------------------------------------------------------------------
# Оплата. Пять способов, четыре независимых выключателя.
# Все пустые/выключены — бот поднимется и будет выдавать только триалы.
# --------------------------------------------------------------------------

# Карта МИР и СБП ВНУТРИ TELEGRAM: токен платёжного провайдера (ЮKassa),
# выдаётся в @BotFather после подключения платежей и одобрения модерации.
# Форму оплаты рисует сам Telegram, пользователь сайт не видит.
PAYMENT_TOKEN=""

# Карта МИР и СБП ОТДЕЛЬНОЙ СТРАНИЦЕЙ: прямая интеграция с ЮKassa, не через
# BotFather. Другая пара ключей — личный кабинет ЮKassa -> Настройки ->
# API-ключи (боевые, не тестовые, если принимаете настоящие деньги).
# Пользователь уходит на страницу ЮKassa и возвращается после оплаты.
# Работает независимо от PAYMENT_TOKEN — можно включить оба сразу.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Куда Caddy проксирует локальный веб-сервер оплаты бота (app/webpay.py):
# это SUB_HOST панели, без схемы. Дефолт подходит, если вы не меняли
# SUB_HOST в panel.env — тогда просто оставьте пустым.
WEB_PAY_HOST=""

# Порт локального веб-сервера оплаты. Наружу не публикуется — Caddy
# проксирует его так же, как API панели. Менять не нужно, если порт
# свободен (проверить: ss -tlnp | grep 8081).
WEB_PAY_PORT="8081"

# Telegram Stars. Токен НЕ нужен: Stars — внутренняя валюта Telegram,
# счёт выставляется без провайдера. Поэтому просто флаг.
# Цены в звёздах — в bot/app/plans.py, их надо сверить перед запуском:
# курс задаёт Telegram, и он меняется.
STARS_ENABLED="false"

# Криптовалюта через @CryptoBot (Crypto Pay API).
# Токен: откройте @CryptoBot -> Crypto Pay -> Create App.
# Пусто = способ выключен.
CRYPTO_PAY_TOKEN=""

# Тестовая сеть Crypto Pay. Для проверки перед запуском.
# ВНИМАНИЕ: при "true" настоящие деньги не приходят, а ключи выдаются.
# Перед приёмом реальных платежей обязательно вернуть в "false".
CRYPTO_TESTNET="false"

# Ссылки, которые бот показывает пользователю. Оферту и политику
# показывать обязательно: согласие с ними — часть оформления подписки.
SUPPORT_URL=""
OFFER_URL="https://khilios.net/legal/offer"
PRIVACY_URL="https://khilios.net/legal/privacy"

# Где лежит база бота. Путь внутри контейнера, снаружи это docker-том
# bot-data. В бэкап попадает через BOT_DIR в infra/panel/backup.sh.
DB_PATH="/data/khilios.sqlite3"

# INFO по умолчанию. DEBUG печатает каждый апдейт — включать только на разбор.
LOG_LEVEL="INFO"
