# Копия: cp node.env.example node.env
# node.env в git не попадает (.gitignore) — там сертификат панели.

# Имя ноды. Только для вывода и записей в runbook.
# На публичной странице статуса показывать можно ТОЛЬКО такое имя и регион.
# Никаких IP и хостнеймов наружу — это подарок для фингерпринтинга.
NODE_NAME="fi-1"

# Отдельный домен ноды (не khilios.net и не basaltworks.ru). Пока домен не
# создан и A-запись с TTL 60 не проверена, оставьте пустым: скрипт не станет
# выдавать пользователям неподготовленное имя. Пример: hel1.khilios-nodes.net
NODE_DOMAIN=""

# IP панельной VPS. Порт ноды открывается файрволом только ему.
PANEL_IP="203.0.113.10"

# Порт, на котором нода слушает панель. Remnawave 3 называет переменную
# NODE_PORT; APP_PORT остаётся совместимым алиасом для старых установок.
NODE_PORT="2222"

# SSH. Нестандартный порт отсекает 99% фонового брутфорса.
SSH_PORT="2202"

# Отключить вход по паролю. Скрипт сам не отключит, если в
# /root/.ssh/authorized_keys нет ключа — чтобы не запереться снаружи.
HARDEN_SSH="yes"

# Публичные порты VPN. Списки разделяются пробелами.
#
# 443 ПЕРВЫМ И НЕ ПРОСТО ТАК. Reality маскируется под обращение к реальному
# чужому сайту — но настоящий HTTPS живёт на 443. TLS-рукопожатие на порту
# 4443 не похоже ни на что настоящее: это единственный признак, который у
# DPI есть до всякого разбора содержимого, и на мобильных сетях, где
# фильтрация жёстче домашней, режут именно по нему.
#
# Поэтому основной вход Reality вешается на 443, а высокие порты остаются
# запасными. Если 443 на ноде занят (см. ниже про NL) — это осознанный
# размен, а не норма.
VPN_TCP_PORTS="443 4443 8443"
# UDP нужен только после отдельного canary-теста Hysteria2 с настоящим TLS-
# сертификатом. Открытый UDP-порт сам по себе режим не включает.
VPN_UDP_PORTS=""

# На ноде NL порт 443 занят Caddy, поэтому используются отдельные порты.
# Эта нода будет заметно хуже работать с мобильного интернета — по причине
# выше. Если она нужна как основная, Caddy стоит унести на другую машину.
# VPN_TCP_PORTS="9443 10443"
# VPN_UDP_PORTS=""

# Remnawave 3: секрет ноды из действующего /opt/remnanode/.env или из панели.
# Для каждой ноды свой, чужой не подойдёт. Не коммитьте заполненный node.env.
SECRET_KEY="ЗАМЕНИ_МЕНЯ"

# Только для старых установок Remnawave Node. Если задан SECRET_KEY, эта
# строка не нужна. Скрипт сохранит совместимость с обеими схемами.
# SSL_CERT='SSL_CERT="ЗАМЕНИ_МЕНЯ"'
