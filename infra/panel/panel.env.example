# Копия: cp panel.env.example panel.env
# panel.env в git не попадает (.gitignore).

# Имя для админки.
#
# Главное правило выполнено: домен панели отделён от домена сайта, поэтому
# блокировка витрины khilios.net не уносит подписки. Домен — basaltworks.ru,
# он уже есть у владельца, DNS в Timeweb, поддомены DNS-only (проксирование
# сломает Reality и выпуск сертификата Caddy).
#
# РИСК, ПРИНЯТЫЙ ОСОЗНАННО. Зона .ru допускает снятие делегирования по
# обращению уполномоченного органа — без суда и необратимо, чего нет у .net.
# Для домена, вшитого в ссылку подписки у каждого пользователя, это худший
# из возможных отказов: он уносит доступ у всех разом, включая оплативших.
# Регистрация в .ru к тому же требует паспортных данных в реестре.
#
# Решение владельца — принять этот риск. План Б, если по .ru придёт
# претензия: домен в .net у другого регистратора, поддомены переезжают
# правкой двух строк здесь и перевыпуском сертификата.
# Оба принятых риска записаны в docs/runbook.md, раздел «Домены».
ADMIN_HOST="panel.basaltworks.ru"

# Имя для страницы подписки. Открыто всем, поэтому отдельным именем:
# так публичная часть не подсказывает, где искать админку.
SUB_HOST="sub.basaltworks.ru"

# Ваш IP. Только с него открывается админка, остальные получают 403.
# Адрес динамический? Оставьте заведомо чужой адрес и ходите
# SSH-туннелем — это надёжнее любого allowlist:
#   ssh -p <порт> -L 8080:127.0.0.1:3000 root@<панель>
ADMIN_IP="203.0.113.5"

# Почта для Let's Encrypt. Сюда приходят письма об истечении сертификата.
ACME_EMAIL="admin@example.net"

# Путь страницы подписки. Проверьте по документации версии, которую ставите:
# ошибка здесь означает, что подписки не открываются, а админка открывается.
SUB_PATH="/api/sub"

# SSH. Нестандартный порт отсекает фоновый брутфорс.
SSH_PORT="2202"
HARDEN_SSH="yes"

# Куда ставить панель.
PANEL_DIR="/opt/remnawave"
