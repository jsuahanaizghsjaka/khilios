# Копия: cp panel.env.example panel.env
# panel.env в git не попадает (.gitignore).

# Имя для админки.
#
# ЖЕЛАТЕЛЬНО: поддомен отдельного домена панели. Блокировка домена сайта
# тогда не уносит с собой подписки, и ключи переезжают сами.
#
# ПОКА отдельного домена нет — поддомен khilios.net. Это хуже (падает
# вместе с сайтом), но приемлемо, и точно лучше домена в зоне .ru:
# такой домен разделегируется по требованию, без суда, а регистрация
# требует паспортных данных в реестре. Для домена, вшитого в ссылку
# подписки у каждого пользователя, и то и другое неприемлемо.
ADMIN_HOST="panel.khilios.net"

# Имя для страницы подписки. Открыто всем, поэтому отдельным именем:
# так публичная часть не подсказывает, где искать админку.
SUB_HOST="sub.khilios.net"

# Ваш IP. Только с него открывается админка, остальные получают 403.
# Адрес динамический? Оставьте заведомо чужой адрес и ходите
# SSH-туннелем — это надёжнее любого allowlist:
#   ssh -p <порт> -L 8080:127.0.0.1:3000 root@<панель>
ADMIN_IP="203.0.113.5"

# Почта для Let's Encrypt. Сюда приходят письма об истечении сертификата.
ACME_EMAIL="admin@example.net"

# Путь страницы подписки. Проверьте по документации версии, которую ставите:
# ошибка здесь означает, что подписки не открываются, а админка открывается.
SUB_PATH="/api/sub"

# SSH. Нестандартный порт отсекает фоновый брутфорс.
SSH_PORT="2202"
HARDEN_SSH="yes"

# Куда ставить панель.
PANEL_DIR="/opt/remnawave"
