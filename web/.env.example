# Копия: cp .env.example .env.local
# .env.local в git не попадает.

# Откуда сайт берёт status.json, который генерирует панель
# (infra/panel/status-json.sh). Если не задать — в разработке показывается
# пример, в продакшене страница честно скажет, что данных нет.
#
# Это имя ПОДПИСКИ (SUB_HOST из panel.env), а не админки: админка отдаёт 403
# всем чужим адресам, и Vercel — тоже чужой. Точный адрес печатает
# deploy-panel.sh в конце работы.
STATUS_URL="https://sub.example.net/status/status.json"

# Ссылка на бота. Пока пусто — кнопки показывают «Скоро открытие».
NEXT_PUBLIC_BOT_URL=""

# Ссылка на канал.
NEXT_PUBLIC_CHANNEL_URL=""
