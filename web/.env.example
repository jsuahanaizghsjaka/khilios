# Копия: cp .env.example .env.local
# .env.local в git не попадает.

# Откуда сайт берёт status.json, который генерирует панель
# (infra/panel/status-json.sh). Если не задать — в разработке показывается
# пример, в продакшене страница честно скажет, что данных нет.
#
# Это имя ПОДПИСКИ (SUB_HOST из panel.env), а не админки: админка отдаёт 403
# всем чужим адресам, и Vercel — тоже чужой. Точный адрес печатает
# deploy-panel.sh в конце работы.
STATUS_URL="https://sub.example.net/status/status.json"

# Ссылка на бота. Если переменная не задана, используется официальный
# https://t.me/khilios_vpn_bot. Здесь можно подменить ссылку для стенда.
NEXT_PUBLIC_BOT_URL="https://t.me/khilios_vpn_bot"

# Ссылка на канал. По умолчанию https://t.me/khiliosvpn (зашита в config.ts),
# переменная нужна только чтобы подменить её, не трогая код.
NEXT_PUBLIC_CHANNEL_URL="https://t.me/khiliosvpn"

# Личный кабинет: ключи приложения Clerk. Пока обе переменные не заданы,
# публичный сайт продолжает работать, а кабинет показывает экран настройки.
# На Vercel удобнее подключить Clerk через Marketplace — ключи добавятся сами.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Собственные маршруты входа и регистрации.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/account"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/account"
