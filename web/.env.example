# Копия: cp .env.example .env.local
# .env.local в git не попадает.

# Откуда сайт берёт status.json, который генерирует панель
# (infra/panel/status-json.sh). Если не задать — в разработке показывается
# пример, в продакшене страница честно скажет, что данных нет.
STATUS_URL="https://panel.example.com/status/status.json"

# Ссылка на бота, например https://t.me/khilios_bot — без параметров,
# сайт сам допишет ?start=plan_<тариф>, чтобы бот сразу открыл нужную оплату.
# Пока пусто — кнопки тарифов показывают «Скоро открытие».
NEXT_PUBLIC_BOT_URL=""

# Своя страница оплаты, если она появится. Если задана — кнопки тарифов
# ведут на неё (?plan=<тариф>) вместо бота. Обычно остаётся пустой:
# по плану платят в боте.
NEXT_PUBLIC_PAY_URL=""

# Ссылка на канал.
NEXT_PUBLIC_CHANNEL_URL=""
